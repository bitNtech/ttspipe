# Copy to .env and edit. run.sh sources this file if present; app/config.py
# reads the exact same variable names, so the shell and the app never disagree.

# --- server ---
TTS_HOST=0.0.0.0
TTS_PORT=8080
TTS_LOG_LEVEL=INFO

# --- model location ---
TTS_MODEL_REPO=scarxity/fish-speech-s2-pro-nf4
TTS_CHECKPOINT_DIR=checkpoints/s2-pro-nf4
TTS_VENDOR_DIR=vendor/fish-speech
# Commit on the fork's main branch that run.sh checks out. Leave unset to use
# run.sh's built-in pin; override to test against a newer fork commit.
#TTS_VENDOR_REF=

# --- inference / VRAM (GTX 1650, 4GB — see run.sh comments) ---
TTS_DEVICE=cuda
TTS_BNB4=true
TTS_HALF=true

# --- the 4 GB profile (all measured on a GTX 1650) ---
# Keep the 155776x2560 fp16 embedding table in host memory (~0.72 GiB saved).
# Without this the model will not load on a 4 GB card at all.
TTS_OFFLOAD_EMBEDDINGS=true
# Must stay off while embeddings are offloaded; the fork requires the sliced head.
TTS_FULL_LM_HEAD=false
# fp16 codec decode yields all-NaN audio on Turing (sm_75) -- silent output, not
# an error. "auto" picks fp32 below sm_80 (+~456 MiB) and fp16 on Ampere+.
TTS_CODEC_PRECISION=auto
# Bound codec activation memory (~250 MiB). 0 disables chunking.
TTS_DECODE_CHUNK_FRAMES=64
TTS_DECODE_OVERLAP_FRAMES=32
TTS_COMPILE=false
# Positions in the KV cache: the ~370-token voice prompt plus a segment's text
# and audio. 1536 leaves ~50 s of audio per batch and saves ~70 MiB over 2048.
TTS_MAX_SEQ_LEN=1536
TTS_CODEC_DECODE_ONLY=true
TTS_REFERENCE_ENCODE_DEVICE=cpu
TTS_WARMUP=true
TTS_LAZY_LOAD=false

# --- streaming behaviour ---
# How much text must accumulate before a segment is speakable. Bounds are in
# CHARACTERS.
TTS_MIN_SEGMENT_CHARS=24
TTS_MAX_SEGMENT_CHARS=220
# ...but this one is in BYTES, and it is what splits a segment into the batches
# the model actually generates. The distinction matters for non-Latin scripts:
# Tamil runs ~2.76 bytes per character, so a 220-character segment is ~600 bytes
# and becomes three batches. Each batch is generated with the previous batch's
# codes in context, so prosody carries across the boundary.
TTS_CHUNK_LENGTH=200
TTS_DEFAULT_FORMAT=wav

# --- latency (all measured on a GTX 1650; see docs/LATENCY.md) ---
# Reuse prompt KV entries across requests instead of re-prefilling the reference
# voice's ~240-350 tokens every time. This is the single biggest lever on
# time-to-first-audio when a cloned voice is in use.
TTS_PREFIX_CACHE=true
# Frames in the first emitted audio block. One frame is 46.4ms of audio and
# costs ~43ms to generate (RTX 2050), so this is the direct TTFA lever.
TTS_STREAM_FIRST_FRAMES=1
# Largest block once audio is playing. Kept small: generation runs at about
# realtime, and a block only leaves once all of it is generated.
TTS_STREAM_MAX_FRAMES=4
# How the prompt's KV entries get populated: auto | batched | sequential.
# bitsandbytes only takes its fused gemv_4bit path at sequence length 1; a
# longer sequence dequantises every weight first, a flat ~490ms whatever the
# span. Walking positions one at a time costs ~48ms each and skips that, so
# short spans are cheaper sequentially. Measured crossover: ~11 tokens.
TTS_PREFILL_MODE=auto
TTS_PREFILL_SEQUENTIAL_MAX=11
# Shortest half-finished segment worth speculatively prefilling while the
# client is still sending it.
TTS_MIN_HINT_CHARS=8
# Most prompt positions one speculative prefill may write.
TTS_HINT_MAX_TOKENS=32
# Shortest gap between two of them. An LLM emits words faster than this card can
# prefill them, so hinting on every frame queues work that is obsolete before it
# runs. Coalescing in the worker is what bounds that; this is just a floor on
# how often one may be issued.
TTS_HINT_MIN_INTERVAL_MS=60
# Whether a hint guesses the whole prompt shape (closing im_end + assistant
# turn) or stops after the text.
TTS_HINT_INCLUDE_SUFFIX=true
# Only for the recomputing codec path (no CUDA graphs); the streaming codec
# carries state instead. Left context per block - its causal convolutions
# reach back 10 frames, so 10 is exact.
TTS_CODEC_LOOKBACK_FRAMES=10
# How far back post_module is re-run per block: 512 measures 48 dB against a
# single full pass (the fp16 floor), 256 only 32.
TTS_CODEC_POST_CONTEXT_FRAMES=512

# --- hand-written kernels (see docs/LATENCY.md#the-throughput-wall) ---
# Serve 4-bit matmuls from app/engine/nf4gemv.py, a tensor-core kernel reading
# bitsandbytes' weights in place: ~96 GB/s of a 112 GB/s card at one position,
# and up to 32 prompt positions for the price of one (bitsandbytes dequantises
# the whole weight for anything past one). Off falls back to bitsandbytes.
TTS_FAST_GEMV=true
# RMS norm and rotary embedding as one kernel each instead of the six to nine
# elementwise operations PyTorch spells them as. ~2900 fewer kernel launches per
# frame. Off falls back to the fork's own code, which is correct and slower.
TTS_FUSED_OPS=true
# Replay each decode step, prompt prefill and codec block as a captured CUDA
# graph. On Windows an eager frame is ~4000 kernel launches at ~30 us of CPU
# each: 152 ms of wall time for 53 ms of GPU work.
TTS_CUDA_GRAPHS=true
# Keep the 200 MiB VQ codebook embedding table in pinned host memory; a frame
# reads ten rows of it over PCIe.
TTS_HOST_CODEBOOK_EMBEDDINGS=true
# VRAM the allocator leaves for the CUDA context, cuDNN and graph executables.
# On Windows an over-full card pages to system RAM instead of failing, which
# is silent and ~15x slower. 0 disables the cap.
TTS_VRAM_HEADROOM_MB=640
# Where libnvrtc.so lives, if not in the nvidia package next to torch. Both of
# the above are compiled at runtime through it; neither needs a C compiler.
#TTS_NVRTC_PATH=/usr/local/cuda/lib64/libnvrtc.so

# --- concurrency ---
TTS_MAX_SESSIONS=8
TTS_QUEUE_TIMEOUT_S=120.0

# --- bootstrap (run.sh) ---
#PYTHON_BIN=/usr/bin/python3.12
#VENV_DIR=.venv
#HF_HOME=.hf-home
#TTS_SKIP_INSTALL=0
#TTS_SKIP_DOWNLOAD=0
